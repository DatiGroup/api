{
  "name": "digital-twins-api",
  "version": "1.0.0",
  "description": "Digital Twins API layer",
  "main": "dist/server.js",
  "keywords": [],
  "author": "",
  "private": true,
  "license": "Private",
  "directories": {
    "test": "test"
  },
  "types": "index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && npm run copy-static",
    "build:tsc": "tsc -p tsconfig.json",
    "dev:debug": "npm run copy-static && tsc-watch --noClear --onSuccess \"node --inspect=0.0.0.0:9229 .\" ",
    "dev:nodebug": "npm run copy-static && tsc-watch --noClear --onSuccess \"node .\" ",
    "dev:tsc": "tsc-watch --noClear -p tsconfig.json",
    "cleanup": "pkill -f 'node --inspect' || true && lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "copy-static": "node scripts/copyTemplates.js&&node scripts/copyLocales.js",
    "start": "node dist/server.js",
    "lint": "eslint '{src,test}/**/*.ts'",
    "lint:fix": "eslint --fix '{src,test}/**/*.ts'",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" yarn jest",
    "test:module": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" yarn jest src/__test__/platformUserTest/*",
    "test:single": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" yarn jest src/__test__/adminTest/product.test.ts",
    "test:watch": "jest --watch",
    "dev:docker": "cross-env NODE_ENV=development_docker TSC_WATCHFILE=FixedPollingInterval TSC_WATCHDIRECTORY=FixedPollingInterval tsc-watch --noClear --onSuccess \"node .\"",
    "dev:docker2": "cross-env NODE_ENV=development_docker nodemon --legacy-watch --watch src src/server.ts",
    "dev": "npm run copy-static && cross-env NODE_ENV=development_locally tsc-watch --noClear --onSuccess \"node --inspect=0.0.0.0 .\" ",
    "dev2": "cross-env NODE_ENV=development_locally nodemon --watch src src/server.ts",
    "docker": "docker compose -f dt-local.yml up",
    "typeorm": "typeorm-ts-node-esm"
  },
